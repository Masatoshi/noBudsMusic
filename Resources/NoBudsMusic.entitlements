<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Store requires this. The app no longer uses any TCC-gated API,
	     so nothing obviously depends on being unsandboxed — but whether
	     MPNowPlayingInfoCenter still wins the Now Playing destination from
	     inside a container is the open question, and it is the mechanism.
	     See docs/adr/0002-distribution-channel.md. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
